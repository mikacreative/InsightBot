# Export in your shell; app does not automatically load .env files.
SIGNAL_DESK_STATE_DIR=
# Blank uses the launcher default; no manual path is required on Mac mini.
# OpenAI-compatible provider. Include /v1 when your provider requires it.
SIGNAL_DESK_AI_BASE_URL=https://api.openai.com/v1
SIGNAL_DESK_AI_API_KEY=
SIGNAL_DESK_AI_MODEL=
# Optional; official JustOneAPI token, NOT a Qiangua cookie.
JUSTONEAPI_TOKEN=
# Optional replay input path (private JSON, not committed).
SIGNAL_DESK_INPUT_FILE=
LANGGRAPH_STRICT_MSGPACK=true
